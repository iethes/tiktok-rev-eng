# RabbitMQ
RABBITMQ_URL=
QUEUE_NAME=
QUEUE_MAX_PRIORITY=20
MAX_RETRY=3

# Google Cloud Storage
GCS_BUCKET_NAME=
GCS_BASE_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Frida
FRIDA_REMOTE=127.0.0.1:27042
FRIDA_PROCESS=TikTok
FRIDA_PORT=27042

# ADB / Device
ADB_DEVICE=localhost:9102
FRIDA_SERVER_PATH=/data/local/tmp/frida-server-17.9.1
TIKTOK_PACKAGE=com.zhiliaoapp.musically

# Scraper
MAX_ATTEMPTS=3
MIN_RESPONSE_LEN=10000
DEFAULT_DELAY=0.5
TIMEOUT=30.0

# Discord (optional)
DISCORD_WEBHOOK_URL=
